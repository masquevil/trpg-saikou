{
  "scopeName": "markdown.npc-card.injection",
  "injectionSelector": "L:text.html.markdown",
  "patterns": [
    {
      "begin": "^\\s*```npc-card\\s*$",
      "end": "^\\s*```\\s*$",
      "name": "meta.embedded.block.npc-card",
      "patterns": [
        {
          "match": "^\\s*:([^\\n]+)$",
          "name": "variable.parameter.custom-field.npc-card"
        },
        {
          "match": "^\\s*(name|role|avatar|summary):",
          "name": "keyword.control.npc-card.field"
        },
        {
          "match": "^\\s*-\\s+",
          "name": "punctuation.definition.list.begin.npc-card"
        },
        {
          "match": "\\b(\\d+)\\b",
          "name": "constant.numeric.npc-card"
        },
        {
          "match": "(jpg|jpeg|png|gif|webp)\\b",
          "name": "support.type.npc-card.image-format"
        }
      ]
    },
    {
      "begin": "^\\s*```npc-summary\\s*$",
      "end": "^\\s*```\\s*$",
      "name": "meta.embedded.block.npc-summary",
      "patterns": [
        {
          "match": "^\\s*(name):",
          "name": "keyword.control.npc-summary.field"
        }
      ]
    }
  ]
}